# Base URL of chiguru-backend (no trailing slash, no /api suffix - the client adds it)
# Confirmed live and reachable at /api/healthz as of this writing.
EXPO_PUBLIC_API_BASE_URL=https://thechiguru.com

# Firebase Web app config - pulled from the public chiguru-owner-web bundle.
# These are not secrets (Firebase web config is public by design, access is
# controlled by Firebase Security Rules, not by hiding these values) but they
# do identify which Firebase project you're pointing at, so double check
# this is the project you intend before shipping a build.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDMV1N50V3Tagr-Xc4gZGIJxlRqKIQTqBU
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=chiguru-fa67f.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=chiguru-fa67f
EXPO_PUBLIC_FIREBASE_APP_ID=1:299684443899:web:2353b749535c66707f625e

# Google Sign-In OAuth Client IDs (from Google Cloud Console, NOT the same as
# the Firebase web config above). At least one is required for the
# "Continue with Google" button to work - set whichever platform(s) you're
# testing on. Get these from Google Cloud Console > APIs & Services >
# Credentials, or Firebase Console > Authentication > Sign-in method > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
